{
  "name": "frequency-words-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyze word frequencies in English books.",
  "main": "dist/presentation/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.build.json && esbuild src/presentation/renderer.ts --bundle --outfile=dist/presentation/renderer.js --platform=browser --format=iife --target=es2022 && node scripts/copy-renderer.cjs",
    "measure:streaming": "npm run build && node scripts/measure-streaming.cjs",
    "package": "npm run build && electron-builder --dir",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:focused": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/bootstrap.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:debug": "npm run build && playwright test --debug",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "architecture": "depcruise --validate .dependency-cruiser.cjs src",
    "test:architecture": "npm run architecture"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.10.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "com.frequencywords.analyzer",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
