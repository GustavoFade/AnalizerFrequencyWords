{
  "name": "frequency-words-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyze word frequencies in English books.",
  "main": "dist/presentation/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.cjs",
    "package": "npm run build && electron-builder --dir",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:focused": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/bootstrap.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "architecture": "depcruise --validate .dependency-cruiser.cjs src",
    "test:architecture": "npm run architecture"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.10.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "sql.js": "^1.12.0"
  },
  "build": {
    "appId": "com.frequencywords.analyzer",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "directories": { "output": "release" }
  }
}
